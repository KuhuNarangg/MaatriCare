@* Index.cshtml - clinic appointments list with status filter, reschedule, and Attended/Missed actions. *@
@model List<Appointment>
@{
    ViewData["Title"] = "Appointments";
    string activeStatus = ViewBag.Status as string ?? "";
}

<div class="dash-header">
  <div>
    <h2>ANC Appointments</h2>
    <p>Book, reschedule, and track attendance across all registered mothers.</p>
  </div>
  <a class="btn" asp-action="Create">+ Book Appointment</a>
</div>

@if (TempData["Success"] != null)
{
  <div class="card" style="background:var(--sage);color:var(--sage-ink);border-color:transparent;padding:12px 18px;">
    @TempData["Success"]
  </div>
}

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
  <a class="page-btn @(activeStatus == "" ? "active" : "")" asp-action="Index">All (@Model.Count)</a>
  <a class="page-btn @(activeStatus == "Scheduled" ? "active" : "")" asp-action="Index" asp-route-status="Scheduled">Scheduled</a>
  <a class="page-btn @(activeStatus == "Attended" ? "active" : "")" asp-action="Index" asp-route-status="Attended">Attended</a>
  <a class="page-btn @(activeStatus == "Missed" ? "active" : "")" asp-action="Index" asp-route-status="Missed">Missed</a>
</div>

<div class="card">
  @if (!Model.Any())
  {
    <div class="empty-state">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="26" fill="#F3EAE0"/><rect x="16" y="18" width="24" height="22" rx="4" stroke="#1F5F5B" stroke-width="2.5"/><path d="M16 25h24" stroke="#F2785C" stroke-width="2.5"/></svg>
      <h3>No appointments found</h3>
      <p>Click "+ Book Appointment" to schedule an upcoming ANC visit.</p>
    </div>
  }
  else
  {
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Mother</th>
          <th>Village</th>
          <th>Purpose &amp; Notes</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var a in Model)
        {
          <tr>
            <td><strong>@a.ScheduledDate.ToString("dd MMM yyyy")</strong></td>
            <td><a asp-controller="Mothers" asp-action="Details" asp-route-id="@a.MotherId">@a.Mother?.Name</a></td>
            <td>@a.Mother?.Village</td>
            <td>
              <strong>@a.Purpose</strong>
              @if (!string.IsNullOrWhiteSpace(a.Notes))
              {
                <br /><small class="muted">@a.Notes</small>
              }
            </td>
            <td><span class="pill @(a.Status == "Attended" ? "low" : a.Status == "Missed" ? "high" : "medium")" style="animation:none;">@a.Status</span></td>
            <td style="white-space:nowrap;">
              <a class="btn ghost small" style="margin-left:0;" asp-action="Reschedule" asp-route-id="@a.Id">Reschedule</a>
              @if (a.Status != "Attended")
              {
                <form asp-action="MarkStatus" method="post" style="display:inline;">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@a.Id" />
                  <input type="hidden" name="status" value="Attended" />
                  <button type="submit" class="btn teal small">Attended</button>
                </form>
              }
              @if (a.Status != "Missed")
              {
                <form asp-action="MarkStatus" method="post" style="display:inline;">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="id" value="@a.Id" />
                  <input type="hidden" name="status" value="Missed" />
                  <button type="submit" class="btn small">Missed</button>
                </form>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
