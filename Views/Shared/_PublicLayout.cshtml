@* _PublicLayout.cshtml - layout for all public-facing pages with sticky navbar and rich footer. *@
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — MaatriCare" : "MaatriCare — Maternal & Newborn Care")</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/public.css" />
</head>
<body>
  <header class="pub-nav">
    <div class="container pub-nav-inner">
      <a class="brand" asp-controller="Public" asp-action="Index">
        <svg width="32" height="32" viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <rect width="36" height="36" rx="10" fill="#1F5F5B"/>
          <path d="M18 26.5C18 26.5 9.5 21.3 9.5 14.8C9.5 11.9 11.8 9.8 14.4 9.8C16.1 9.8 17.4 10.7 18 11.8C18.6 10.7 19.9 9.8 21.6 9.8C24.2 9.8 26.5 11.9 26.5 14.8C26.5 21.3 18 26.5 18 26.5Z" fill="#F2785C"/>
          <circle cx="18" cy="17.5" r="3" fill="#FBF6F0"/>
        </svg>
        Maatri<span>Care</span>
      </a>

      <ul class="nav-links" id="navLinks">
        <li><a class="@(currentAction == "Index" ? "active" : "")" asp-controller="Public" asp-action="Index">Home</a></li>
        <li><a class="@(currentAction == "About" ? "active" : "")" asp-controller="Public" asp-action="About">About</a></li>
        <li><a class="@(currentAction == "Services" ? "active" : "")" asp-controller="Public" asp-action="Services">Services</a></li>
        <li><a class="@(currentAction == "HowItWorks" ? "active" : "")" asp-controller="Public" asp-action="HowItWorks">How It Works</a></li>
        <li><a class="@(currentAction == "HealthTips" ? "active" : "")" asp-controller="Public" asp-action="HealthTips">Health Tips</a></li>
        <li><a class="@(currentAction == "Faq" ? "active" : "")" asp-controller="Public" asp-action="Faq">FAQ</a></li>
        <li><a class="@(currentAction == "Contact" ? "active" : "")" asp-controller="Public" asp-action="Contact">Contact</a></li>
      </ul>

      <div class="nav-actions">
        @if (isLoggedIn)
        {
          <a class="btn btn-teal" asp-controller="Home" asp-action="Index">Go to dashboard</a>
        }
        else
        {
          <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Staff Login</a>
        }
        <button type="button" class="hamburger" id="menuToggle" aria-label="Toggle navigation" aria-expanded="false">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main>
    @RenderBody()
  </main>

  <footer class="pub-footer">
    <div class="container">
      <div class="footer-grid">
        <div>
          <a class="brand" asp-controller="Public" asp-action="Index" style="color:#fff;margin-bottom:12px;">
            Maatri<span>Care</span>
          </a>
          <p style="margin:8px 0 0;font-size:.93rem;max-width:300px;">
            Warm, structured maternal and newborn follow-up software built for primary health clinics, doctors, and village health workers across Punjab.
          </p>
        </div>
        <div>
          <h4>Explore</h4>
          <ul>
            <li><a asp-controller="Public" asp-action="Index">Home</a></li>
            <li><a asp-controller="Public" asp-action="About">About MaatriCare</a></li>
            <li><a asp-controller="Public" asp-action="Services">Our Services</a></li>
            <li><a asp-controller="Public" asp-action="HowItWorks">How It Works</a></li>
          </ul>
        </div>
        <div>
          <h4>Resources</h4>
          <ul>
            <li><a asp-controller="Public" asp-action="HealthTips">Maternal Health Tips</a></li>
            <li><a asp-controller="Public" asp-action="Faq">Frequently Asked Questions</a></li>
            <li><a asp-controller="Public" asp-action="Contact">Contact Clinic Team</a></li>
            <li><a asp-controller="Account" asp-action="Login">Staff Portal Login</a></li>
          </ul>
        </div>
        <div>
          <h4>Clinic Desk</h4>
          <ul>
            <li>Phagwara Primary Health Unit, Punjab</li>
            <li>Mon – Sat: 8:30 AM – 4:30 PM</li>
            <li>Helpline: +91 1824-260-108</li>
            <li>care@maatricare.org</li>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>&copy; @DateTime.Now.Year MaatriCare Maternal &amp; Newborn Follow-Up Platform.</span>
        <span>Built with ASP.NET Core MVC &amp; SQLite &bull; India UIP Aligned</span>
      </div>
    </div>
  </footer>

  <script src="~/js/public.js"></script>
</body>
</html>
