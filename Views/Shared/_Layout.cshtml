@* _Layout.cshtml - authenticated app shell with role-based sidebar navigation, topbar role badge, search, and notifications. *@
@using System.Security.Claims
@inject DashboardService DashSvc
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var username = User.Identity?.Name ?? "";
    var role = PermissionService.GetRole(User);
    var (homeAct, homeCtrl) = PermissionService.GetLandingRoute(role);
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var act = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var stageQuery = (Context.Request.Query["stage"].ToString() ?? "").ToLower();
    var notifications = (isAuth && PermissionService.CanViewFollowUpsAndReferrals(User))
        ? await DashSvc.GetTopbarNotificationsAsync()
        : new List<FollowUpItem>();
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — MaatriCare" : "MaatriCare Portal")</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ctrl == "Home" ? "page-dashboard" : "")">
@if (isAuth)
{
  <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
  <div class="app-shell">
    <aside class="sidebar" id="appSidebar">
      <div class="sidebar-top">
        <a class="side-brand" asp-controller="@homeCtrl" asp-action="@homeAct">
          <svg width="28" height="28" viewBox="0 0 36 36" fill="none" aria-hidden="true">
            <rect width="36" height="36" rx="10" fill="#164643"/>
            <path d="M18 26.5C18 26.5 9.5 21.3 9.5 14.8C9.5 11.9 11.8 9.8 14.4 9.8C16.1 9.8 17.4 10.7 18 11.8C18.6 10.7 19.9 9.8 21.6 9.8C24.2 9.8 26.5 11.9 26.5 14.8C26.5 21.3 18 26.5 18 26.5Z" fill="#F2785C"/>
            <circle cx="18" cy="17.5" r="3" fill="#FBF6F0"/>
          </svg>
          <span class="side-brand-text">Maatri<span>Care</span></span>
        </a>
        <button type="button" class="collapse-btn" id="collapseSidebarBtn" title="Toggle sidebar" aria-label="Collapse sidebar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
      </div>

      <div class="nav-section">Workspace</div>
      @if (role == Roles.Admin)
      {
        <a class="side-link @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" title="Admin Dashboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>
          <span class="side-label">Admin Dashboard</span>
        </a>
      }
      @if (role == Roles.Mother)
      {
        <a class="side-link @(ctrl == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index" title="My Dashboard">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9" rx="2"/><rect x="14" y="3" width="7" height="5" rx="2"/><rect x="14" y="12" width="7" height="9" rx="2"/><rect x="3" y="16" width="7" height="5" rx="2"/></svg>
          <span class="side-label">My Dashboard</span>
        </a>
      }
      @if (role == Roles.Doctor)
      {
        <a class="side-link @(ctrl == "Doctor" ? "active" : "")" asp-controller="Doctor" asp-action="Index" title="Doctor Portal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
          <span class="side-label">Doctor Portal</span>
        </a>
      }
      @if (role == Roles.Nurse)
      {
        <a class="side-link @(ctrl == "Nurse" ? "active" : "")" asp-controller="Nurse" asp-action="Index" title="Nurse Portal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 6v12M6 12h12"/><rect x="3" y="3" width="18" height="18" rx="4"/></svg>
          <span class="side-label">Nurse Portal</span>
        </a>
      }
      @if (PermissionService.CanScheduleAppointments(User))
      {
        <a class="side-link @(ctrl == "Reception" ? "active" : "")" asp-controller="Reception" asp-action="Index" title="Reception Desk">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
          <span class="side-label">Reception Desk</span>
        </a>
      }
      @if (PermissionService.CanViewLivePortal(User))
      {
        <a class="side-link @(ctrl == "LivePortal" ? "active" : "")" asp-controller="LivePortal" asp-action="Index" title="Live Portal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
          <span class="side-label">Live Portal</span>
        </a>
      }

      @if (PermissionService.CanViewAllPatients(User))
      {
        <div class="nav-section">Patients &amp; Care</div>
        <a class="side-link @(ctrl == "Mothers" && act == "Index" && stageQuery != "delivered" ? "active" : "")" asp-controller="Mothers" asp-action="Index" asp-route-stage="expectant" title="Expectant Mothers">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          <span class="side-label">Expectant Mothers</span>
        </a>
        <a class="side-link @(ctrl == "Mothers" && act == "Index" && stageQuery == "delivered" ? "active" : "")" asp-controller="Mothers" asp-action="Index" asp-route-stage="delivered" title="Delivered Mothers">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 6L9 17l-5-5"/></svg>
          <span class="side-label">Delivered Mothers</span>
        </a>
        <a class="side-link @(ctrl == "Newborns" && act == "Index" ? "active" : "")" asp-controller="Newborns" asp-action="Index" title="Baby Portal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="9" cy="10" r="1"/><circle cx="15" cy="10" r="1"/><path d="M9 15c1.5 1.3 4.5 1.3 6 0"/></svg>
          <span class="side-label">Baby Portal</span>
        </a>
        <a class="side-link @(ctrl == "Mothers" && act == "Create" ? "active" : "")" asp-controller="Mothers" asp-action="Create" title="Register Patient">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
          <span class="side-label">Register Patient</span>
        </a>
        <a class="side-link @(ctrl == "Newborns" && act == "Vaccines" ? "active" : "")" asp-controller="Newborns" asp-action="Vaccines" title="Vaccination Tracker">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 2 4 4M17 7l3-3M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5M9 11l4 4M5 19l-3 3"/></svg>
          <span class="side-label">Vaccination Tracker</span>
        </a>
      }

      @if (PermissionService.CanViewFollowUpsAndReferrals(User))
      {
        <div class="nav-section">Outreach &amp; Desk</div>
        <a class="side-link @(ctrl == "FollowUps" ? "active" : "")" asp-controller="FollowUps" asp-action="Index" title="Follow-Ups">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.58 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          <span class="side-label">Follow-Ups</span>
        </a>
        <a class="side-link @(ctrl == "Referrals" ? "active" : "")" asp-controller="Referrals" asp-action="Index" title="Hospital Referrals">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M7 7h10v10"/></svg>
          <span class="side-label">Referrals</span>
        </a>
        <a class="side-link @(ctrl == "Notifications" ? "active" : "")" asp-controller="Notifications" asp-action="Index" title="Notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="side-label">Notifications</span>
        </a>
      }

      @if (PermissionService.IsAdmin(User))
      {
        <div class="nav-section">Administration</div>
        <a class="side-link @(ctrl == "Users" ? "active" : "")" asp-controller="Users" asp-action="Index" title="Users & Roles">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span class="side-label">Users &amp; Roles</span>
        </a>
        <a class="side-link @(ctrl == "Tips" ? "active" : "")" asp-controller="Tips" asp-action="Index" title="Health Tips">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          <span class="side-label">Health Tips</span>
        </a>
        <a class="side-link @(ctrl == "Audit" ? "active" : "")" asp-controller="Audit" asp-action="Index" title="Audit Log">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>
          <span class="side-label">Audit Log</span>
        </a>
      }

      <div class="nav-section">Account</div>
      <a class="side-link @(ctrl == "Profile" ? "active" : "")" asp-controller="Profile" asp-action="Index" title="My Profile">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <span class="side-label">My Profile</span>
      </a>
      <a class="side-link" asp-controller="Public" asp-action="Index" title="Public Site">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        <span class="side-label">Public Site</span>
      </a>

      <div class="side-footer">
        <span class="side-label">Signed in as <strong>@username</strong><br />Role: @role</span>
      </div>
    </aside>

    <div class="app-main">
      <header class="topbar">
        <div class="topbar-left">
          <button type="button" class="mobile-menu-btn" id="mobileSidebarBtn" aria-label="Open menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
          </button>

          @if (PermissionService.CanViewAllPatients(User))
          {
            <form class="global-search" method="get" asp-controller="Mothers" asp-action="Index">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#617371" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
              <input name="q" placeholder="Search patients or village..." aria-label="Global search" />
            </form>
          }
          else
          {
            <span style="font-weight:600;color:var(--teal);">My Maternal Care Portal</span>
          }
        </div>

        <div class="topbar-right">
          <span class="role-topbar-badge" title="Active Role">@role</span>

          @if (PermissionService.CanViewFollowUpsAndReferrals(User))
          {
            <div class="dropdown">
              <button type="button" class="icon-btn" data-dropdown-trigger aria-label="Notifications">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                @if (notifications.Count > 0)
                {
                  <span class="bell-badge">@notifications.Count</span>
                }
              </button>
              <div class="dropdown-menu">
                <div class="dropdown-title">Clinical Alerts (@notifications.Count)</div>
                @if (notifications.Count == 0)
                {
                  <p class="muted small" style="padding:8px;">All clear! No urgent alerts.</p>
                }
                @foreach (var n in notifications)
                {
                  <a class="notif-item" href="@n.LinkUrl">
                    <strong>@n.Title</strong>
                    <span>@n.Subtitle</span>
                  </a>
                }
                <a class="notif-item" asp-controller="Notifications" asp-action="Index" style="text-align:center;color:var(--coral);font-weight:600;border-top:1px solid var(--border);margin-top:6px;">
                  Open Notification Centre &rarr;
                </a>
              </div>
            </div>
          }

          <div class="dropdown">
            <button type="button" class="profile-btn" data-dropdown-trigger>
              <span class="avatar">@(username.Length > 0 ? username[0].ToString().ToUpper() : "U")</span>
              <span class="profile-name">@username</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="dropdown-menu profile-menu">
              <div class="dropdown-title">@username <span class="pill low" style="margin-left:4px;">@role</span></div>
              <a asp-controller="@homeCtrl" asp-action="@homeAct">My Workspace</a>
              <a asp-controller="Profile" asp-action="Index">My Profile</a>
              <a asp-controller="Public" asp-action="Index">View Public Website</a>
              <a asp-controller="Account" asp-action="Logout" style="color:var(--rose-ink);font-weight:600;">Log out</a>
            </div>
          </div>
        </div>
      </header>

      <main class="app-content @(ctrl == "Home" ? "app-content-dashboard" : "")">
        @RenderBody()
      </main>
    </div>
  </div>
}
else
{
  <main class="app-content">@RenderBody()</main>
}
<script src="~/js/app.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
