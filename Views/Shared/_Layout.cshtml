<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f7f8f5" />
  <meta name="description" content="Thoughtful maternal and newborn care, made easier to manage." />
  <title>MaatriCare | Care, connected</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
  <aside class="side">
    <a class="brand" asp-controller="Home" asp-action="Index" aria-label="MaatriCare home"><span class="brand-mark">m</span><span>Maatri<span class="brand-accent">Care</span><small>CARE, CONNECTED</small></span></a>
    <div class="nav-label">WORKSPACE</div>
    <nav aria-label="Main navigation">
      <a class="nav-link" asp-controller="Home" asp-action="Index"><span class="nav-symbol">⌂</span>Overview</a>
      <a class="nav-link" asp-controller="Mothers" asp-action="Index"><span class="nav-symbol">◉</span>Mothers</a>
      <a class="nav-link nav-primary" asp-controller="Mothers" asp-action="Create"><span class="nav-symbol">＋</span>Register mother</a>
    </nav>
    <div class="side-note"><span class="note-dot"></span>Care starts with connection</div>
    <div class="who"><span class="avatar">@(User.Identity.Name?.Substring(0, 1).ToUpperInvariant())</span><span class="user-copy"><strong>@User.Identity.Name</strong><a asp-controller="Account" asp-action="Logout">Sign out</a></span></div>
  </aside>
}
<main class="@(User.Identity?.IsAuthenticated == true ? "with-side" : "")">@RenderBody()</main>
</body>
</html>
