@* Index.cshtml - Notification Centre displaying simulated SMS reminders with read/unread controls. *@
@model List<Notification>
@{
    ViewData["Title"] = "Notification Centre";
    string filter = ViewBag.Filter as string ?? "all";
    int unreadCount = ViewBag.UnreadCount ?? 0;
}

<div class="dash-header">
  <div>
    <h2>Notification Centre</h2>
    <p>Simulated SMS reminders for upcoming visits, overdue ANC check-ups, and due vaccines.</p>
  </div>
  <div class="quick-actions">
    <form asp-action="Generate" method="post" style="display:inline;">
      @Html.AntiForgeryToken()
      <button type="submit" class="btn">Generate SMS Reminders</button>
    </form>
    @if (unreadCount > 0)
    {
      <form asp-action="MarkAllRead" method="post" style="display:inline;">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn teal">Mark All Read (@unreadCount)</button>
      </form>
    }
  </div>
</div>

@if (TempData["Success"] != null)
{
  <div class="card" style="background:var(--sage);color:var(--sage-ink);border-color:transparent;padding:12px 18px;">
    @TempData["Success"]
  </div>
}

<div style="display:flex;gap:8px;margin-bottom:16px;">
  <a class="page-btn @(filter == "all" ? "active" : "")" asp-action="Index" asp-route-filter="all">All Notifications</a>
  <a class="page-btn @(filter == "unread" ? "active" : "")" asp-action="Index" asp-route-filter="unread">Unread (@unreadCount)</a>
</div>

<div class="card">
  @if (!Model.Any())
  {
    <div class="empty-state">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="26" fill="#CFE3D4"/><path d="M18 28l7 7 13-13" stroke="#1F5F5B" stroke-width="3.5" stroke-linecap="round"/></svg>
      <h3>You're all caught up</h3>
      <p>Click "Generate SMS Reminders" to scan for upcoming visits, overdue ANC check-ups, and due vaccines.</p>
    </div>
  }
  else
  {
    <div class="list-stack">
      @foreach (var n in Model)
      {
        <div class="list-row" style="@(n.IsRead ? "opacity:0.75;" : "border-left:4px solid var(--coral);")">
          <div>
            <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:4px;">
              <span class="pill @(n.Category.Contains("Overdue") ? "high" : n.Category.Contains("Vaccine") ? "medium" : "low")" style="animation:none;">@n.Category</span>
              <span class="pill ghost small" style="background:#fff;border:1px solid var(--border);color:var(--muted);">@n.Channel &bull; @n.Phone</span>
              <small class="muted">@n.CreatedAt.ToString("dd MMM, hh:mm tt")</small>
            </div>
            <a href="@n.LinkUrl"><strong>@n.Title</strong></a>
            <small>@n.Message</small>
          </div>
          <div style="white-space:nowrap;">
            @if (!n.IsRead)
            {
              <form asp-action="MarkRead" asp-route-id="@n.Id" method="post" style="display:inline;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="filter" value="@filter" />
                <button type="submit" class="btn ghost small" style="margin-left:0;">Mark Read</button>
              </form>
            }
            else
            {
              <span class="small muted">Read</span>
            }
          </div>
        </div>
      }
    </div>
  }
</div>
