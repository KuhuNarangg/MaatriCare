@* Index.cshtml - MaatriCare public home page with hero, stats, services, workflow, testimonials and tips. *@
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Maternal & Newborn Care";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<section class="hero-cinematic">
  <div class="container">
    <div class="hero-cinematic-inner">
      <span class="hero-glass-chip">Maternal &amp; Newborn Follow-Up Platform</span>
      <h1>Every mother seen.<br />Every baby <span>protected on time.</span></h1>
      <p class="lead">
        MaatriCare helps rural health workers, doctors, and clinics track antenatal check-ups, flag high-risk pregnancies early with clear reasons, and keep every newborn's vaccination schedule on track.
      </p>
      <div class="hero-ctas">
        @if (isLoggedIn)
        {
          <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to Dashboard</a>
        }
        else
        {
          <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Staff Portal Login</a>
        }
        <a class="btn btn-glass" asp-controller="Public" asp-action="HowItWorks">See How It Works</a>
      </div>
      <div class="hero-trust-strip">
        <span class="hero-trust-pill">40-Week ANC Tracking</span>
        <span class="hero-trust-pill">Explainable Clinical Risk Score</span>
        <span class="hero-trust-pill">7 India UIP Vaccines</span>
      </div>
    </div>
  </div>
</section>

<section class="stats-strip">
  <div class="container stats-grid">
    <div class="stat-item"><strong>40 Weeks</strong><span>Full antenatal journey tracking</span></div>
    <div class="stat-item"><strong>100% Clear</strong><span>Explainable risk factors, no black box</span></div>
    <div class="stat-item"><strong>7 Milestones</strong><span>Auto-generated India UIP vaccines</span></div>
    <div class="stat-item"><strong>4+ Villages</strong><span>Built for Punjab primary health outreach</span></div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="chip chip-butter">Core Capabilities</span>
      <h2>Designed for calm, dependable clinic follow-up</h2>
      <p>From the very first antenatal registration to a baby's 9-month measles-rubella dose, MaatriCare keeps every record in one clear place.</p>
    </div>
    <div class="grid-3">
      <div class="pub-card reveal">
        <div class="icon-box">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2Z"/></svg>
        </div>
        <h3>Antenatal Tracking</h3>
        <p>Automatically calculates pregnancy week and expected delivery date (EDD) from LMP, while logging BP, Hb, and blood sugar at each visit.</p>
      </div>
      <div class="pub-card reveal">
        <div class="icon-box">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/></svg>
        </div>
        <h3>Explainable Risk Detection</h3>
        <p>Flags Low, Medium, or High risk immediately and shows exact medical reasons—such as severe anaemia or high BP—so staff can refer fast.</p>
      </div>
      <div class="pub-card reveal">
        <div class="icon-box">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M5 20c0-3.9 3.1-7 7-7s7 3.1 7 7"/></svg>
        </div>
        <h3>Newborn Registry</h3>
        <p>Links every newborn directly to their mother's profile with birth weight, date of birth, and gender for seamless postnatal continuity.</p>
      </div>
      <div class="pub-card reveal">
        <div class="icon-box">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m18 2 4 4M17 7l3-3M19 9 8.7 19.3c-1 1-2.5 1-3.4 0l-.6-.6c-1-1-1-2.5 0-3.4L15 5M9 11l4 4M5 19l-3 3"/></svg>
        </div>
        <h3>UIP Vaccination Tracking</h3>
        <p>Generates all 7 India Universal Immunisation Programme due dates automatically from birth and highlights overdue doses.</p>
      </div>
      <div class="pub-card reveal">
        <div class="icon-box">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 0 1-3.46 0"/></svg>
        </div>
        <h3>Timely Follow-Up Alerts</h3>
        <p>Surfaces deliveries expected within 30 days and missed check-ups on the dashboard so no family slips through the cracks.</p>
      </div>
      <div class="pub-card reveal">
        <div class="icon-box">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18M7 14l4-4 4 4 5-6"/></svg>
        </div>
        <h3>Clinic Overview &amp; Reports</h3>
        <p>Gives doctors and administrators an instant view of village-wide maternal risk distribution and immunization progress.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:32px;">
      <a class="btn btn-outline" asp-controller="Public" asp-action="Services">Explore All Services</a>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="chip chip-sage">Simple 4-Step Flow</span>
      <h2>How MaatriCare works in the field</h2>
      <p>Built for busy primary health centres with zero clutter and fast data entry on both desktop and mobile screens.</p>
    </div>
    <div class="grid-4">
      <div class="pub-card reveal">
        <div class="step-num">1</div>
        <h3>Register Mother</h3>
        <p>Record age, village, phone, blood group, C-section history, and LMP. Pregnancy week and EDD appear automatically.</p>
      </div>
      <div class="pub-card reveal">
        <div class="step-num">2</div>
        <h3>Log ANC Visits</h3>
        <p>Enter BP, hemoglobin, and blood sugar at every check-up. Risk level updates live with clear clinical explanations.</p>
      </div>
      <div class="pub-card reveal">
        <div class="step-num">3</div>
        <h3>Register Newborn</h3>
        <p>After delivery, add the baby's details. MaatriCare instantly schedules all 7 essential UIP vaccines by exact due date.</p>
      </div>
      <div class="pub-card reveal">
        <div class="step-num">4</div>
        <h3>Track &amp; Follow Up</h3>
        <p>Mark vaccines as given in one click and review upcoming deliveries and high-risk alerts every morning on the dashboard.</p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="chip chip-rose">Community Voices</span>
      <h2>Trusted by doctors, health workers, and families</h2>
    </div>
    <div class="grid-3">
      <div class="pub-card reveal">
        <div class="quote-mark">&ldquo;</div>
        <p>Before MaatriCare, spotting anaemia or rising blood pressure meant flipping through three paper registers. Now the high-risk badge and exact reasons appear in seconds.</p>
        <div class="author">
          <strong>Dr. Manpreet Gill</strong>
          <span>Medical Officer, Phagwara PHC</span>
        </div>
      </div>
      <div class="pub-card reveal">
        <div class="quote-mark">&ldquo;</div>
        <p>It works smoothly on my phone during village visits in Nangal and Hadiabad. Marking a newborn's BCG or Pentavalent dose takes just one tap.</p>
        <div class="author">
          <strong>Gurpreet Kaur</strong>
          <span>ANM Health Worker</span>
        </div>
      </div>
      <div class="pub-card reveal">
        <div class="quote-mark">&ldquo;</div>
        <p>Knowing my expected delivery date and getting timely reminders for my baby's 6-week and 10-week vaccines gave our entire family peace of mind.</p>
        <div class="author">
          <strong>Anita Rani</strong>
          <span>Mother, Phagwara</span>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head reveal">
      <span class="chip chip-butter">Health Education</span>
      <h2>Practical maternal &amp; newborn health tips</h2>
      <p>Clear, evidence-based guidance every expectant mother and family should know.</p>
    </div>
    <div class="grid-3">
      <div class="pub-card reveal">
        <img src="~/images/baby-feet.jpg" alt="Mother holding newborn feet in soft light" class="card-photo" />
        <span class="chip chip-sage">First Trimester</span>
        <h3>Why early ANC registration matters</h3>
        <p>Registering before 12 weeks ensures accurate EDD tracking, early folic acid supplementation, and baseline hemoglobin screening.</p>
      </div>
      <div class="pub-card reveal">
        <img src="~/images/newborn-scale.jpg" alt="Newborn check-up and birth weight monitoring" class="card-photo" />
        <span class="chip chip-rose">Danger Signs</span>
        <h3>Recognizing high BP &amp; severe anaemia</h3>
        <p>Persistent headaches, swelling, BP above 140/90, or hemoglobin below 7 g/dL require prompt doctor evaluation and referral.</p>
      </div>
      <div class="pub-card reveal">
        <img src="~/images/baby-crib.jpg" alt="Peaceful newborn resting safely in crib" class="card-photo" />
        <span class="chip chip-butter">Newborn Care</span>
        <h3>Birth-dose vaccines within 24 hours</h3>
        <p>BCG, OPV 0, and Hepatitis B at birth protect newborns during their most vulnerable first weeks of life.</p>
      </div>
    </div>
    <div style="text-align:center;margin-top:32px;">
      <a class="btn btn-outline" asp-controller="Public" asp-action="HealthTips">Read All Health Tips</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cta-banner reveal">
      <h2>Ready to manage maternal &amp; newborn care with clarity?</h2>
      <p>Sign in to the MaatriCare staff portal to review your clinic dashboard, or reach out to our team for onboarding support.</p>
      <div class="hero-ctas" style="justify-content:center;">
        @if (isLoggedIn)
        {
          <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Open Dashboard</a>
        }
        else
        {
          <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Staff Login</a>
        }
        <a class="btn btn-light" asp-controller="Public" asp-action="Contact">Contact Us</a>
      </div>
    </div>
  </div>
</section>
