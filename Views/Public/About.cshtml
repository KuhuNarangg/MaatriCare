@* About.cshtml - mission, background, and clinical values of the MaatriCare platform. *@
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "About Us";
}

<section class="page-hero">
  <div class="container">
    <span class="chip chip-sage">Our Mission</span>
    <h1>Warm, dependable digital care for mothers and newborns</h1>
    <p>MaatriCare was created to replace scattered paper registers with a calm, transparent follow-up platform built around real primary health workflows.</p>
  </div>
</section>

<section class="section">
  <div class="container grid-2" style="align-items:center;">
    <div class="reveal">
      <h2>Why MaatriCare exists</h2>
      <p style="color:var(--muted);">
        In rural and semi-urban primary health centres, ANMs and doctors care for dozens of expectant mothers across multiple villages. Critical risk factors—like severe anaemia, gestational hypertension, or missed antenatal visits—are easy to miss when notes live on separate paper sheets.
      </p>
      <p style="color:var(--muted);">
        MaatriCare brings antenatal tracking, explainable clinical risk scoring, newborn registration, and India's Universal Immunisation Programme (UIP) schedule together in one lightweight, mobile-friendly web application.
      </p>
    </div>
    <div class="hero-art reveal">
      <img src="~/images/newborn-scale.jpg" alt="Clinician gently weighing a newborn baby in clinic" class="feature-photo" />
    </div>
  </div>
</section>

<section class="section section-soft">
  <div class="container">
    <div class="section-head reveal">
      <h2>Principles behind every screen</h2>
    </div>
    <div class="grid-3">
      <div class="pub-card reveal">
        <span class="chip chip-sage">Transparent</span>
        <h3>Explainable Risk Rules</h3>
        <p>Every risk score lists the exact contributing factors in plain language so clinicians always stay in control of medical decisions.</p>
      </div>
      <div class="pub-card reveal">
        <span class="chip chip-butter">Accessible</span>
        <h3>Mobile-First in the Field</h3>
        <p>Clean layouts, generous tap targets, and fast page loads mean health workers can update records right from village outreach camps.</p>
      </div>
      <div class="pub-card reveal">
        <span class="chip chip-rose">Continuity</span>
        <h3>Mother-to-Baby Link</h3>
        <p>Antenatal history flows directly into newborn registration and immunization follow-up without re-entering family details.</p>
      </div>
    </div>
  </div>
</section>
