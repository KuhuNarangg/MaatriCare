@* Services.cshtml - detailed breakdown of all six MaatriCare maternal and newborn services. *@
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Services";
}

<section class="page-hero">
  <div class="container">
    <span class="chip chip-butter">What We Offer</span>
    <h1>End-to-end maternal &amp; newborn services</h1>
    <p>Six integrated modules designed to support primary health clinics from early pregnancy through infant immunisation.</p>
  </div>
</section>

<section class="section">
  <div class="container grid-2">
    <div class="pub-card reveal">
      <span class="chip chip-sage">01 &bull; Antenatal Care</span>
      <h3>Antenatal Tracking</h3>
      <p>Register expectant mothers with village, contact info, blood group, and LMP. MaatriCare automatically calculates the current pregnancy week (0–40) and expected delivery date (EDD), and keeps a complete history of BP, hemoglobin, blood sugar, and clinician notes.</p>
    </div>

    <div class="pub-card reveal">
      <span class="chip chip-rose">02 &bull; Clinical Safety</span>
      <h3>Explainable Risk Detection</h3>
      <p>Rule-based scoring evaluates maternal age, prior C-section, high blood pressure (&ge;140/90), mild or severe anaemia (Hb &lt; 11 or &lt; 7), elevated blood sugar (&ge;140), and overdue check-ups—assigning Low, Medium, or High risk with clear reasons.</p>
    </div>

    <div class="pub-card reveal">
      <span class="chip chip-sage">03 &bull; Postnatal Continuity</span>
      <h3>Newborn Registry</h3>
      <p>Link newborns directly to their mother's record with date of birth, gender, and birth weight. Every baby gets a dedicated profile ready for growth and vaccine follow-up.</p>
    </div>

    <div class="pub-card reveal">
      <span class="chip chip-butter">04 &bull; India UIP Schedule</span>
      <h3>Vaccination Tracking</h3>
      <p>Automatically generates all 7 core UIP vaccines from the baby's date of birth (Birth: BCG, OPV 0, Hep B; 6w, 10w, 14w Pentavalent/Rota/IPV; 9m MR 1). Color-coded Given, Pending, and Overdue chips make follow-up effortless.</p>
    </div>

    <div class="pub-card reveal">
      <span class="chip chip-butter">05 &bull; Outreach</span>
      <h3>Follow-Up Reminders</h3>
      <p>Highlights deliveries expected in the next 30 days, mothers overdue for antenatal visits, and infants with pending or overdue doses so health workers know exactly who to call or visit each morning.</p>
    </div>

    <div class="pub-card reveal">
      <span class="chip chip-sage">06 &bull; Visibility</span>
      <h3>Clinic Reports &amp; Insights</h3>
      <p>Live dashboard metrics summarize total mothers registered, risk distribution across Low/Medium/High tiers, newborn counts, and overdue vaccines for rapid clinical review.</p>
    </div>
  </div>
</section>
