@* Index.cshtml - Admin & Receptionist Follow-Ups queue (Today/Overdue/Upcoming) with Mark Contacted & notes. *@
@model FollowUpPageViewModel
@{
    ViewData["Title"] = "Follow-Ups";
}

<div class="dash-header">
  <div>
    <h2>Follow-Ups Queue</h2>
    <p>Missed appointments, overdue ANC visits, and overdue vaccines with contact tracking (Admin &amp; Receptionist only).</p>
  </div>
  <a class="btn teal" asp-controller="Notifications" asp-action="Index">Open SMS Reminders</a>
</div>

@if (TempData["Success"] != null)
{
  <div class="card" style="background:var(--sage);color:var(--sage-ink);border-color:transparent;padding:12px 18px;">
    @TempData["Success"]
  </div>
}

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
  <a class="page-btn @(Model.Tab == "today" ? "active" : "")" asp-action="Index" asp-route-tab="today">Today (@Model.TodayCount)</a>
  <a class="page-btn @(Model.Tab == "overdue" ? "active" : "")" asp-action="Index" asp-route-tab="overdue">Overdue (@Model.OverdueCount)</a>
  <a class="page-btn @(Model.Tab == "upcoming" ? "active" : "")" asp-action="Index" asp-route-tab="upcoming">Upcoming (@Model.UpcomingCount)</a>
</div>

<div class="card">
  @if (!Model.Items.Any())
  {
    <div class="empty-state">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="26" fill="#CFE3D4"/><path d="M18 28l7 7 13-13" stroke="#1F5F5B" stroke-width="3.5" stroke-linecap="round"/></svg>
      <h3>No follow-ups in this tab</h3>
      <p>Switch to Overdue or Upcoming to review missed appointments, overdue ANC visits, and due vaccines.</p>
    </div>
  }
  else
  {
    <table>
      <thead>
        <tr>
          <th>Type</th>
          <th>Patient &amp; Village</th>
          <th>Action Needed</th>
          <th>Due Date</th>
          <th>Mark Contacted &amp; Note</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var item in Model.Items)
        {
          <tr>
            <td><span class="pill @(item.Status == "Overdue" ? "high" : item.Status == "Today" ? "medium" : "low")" style="animation:none;">@item.Kind</span></td>
            <td>
              <a href="@item.DetailUrl"><strong>@item.PersonName</strong></a><br />
              <small class="muted">@item.Village &bull; @item.Phone</small>
              @if (!string.IsNullOrWhiteSpace(item.Phone))
              {
                <br /><a class="small" href="tel:@item.Phone">Call @item.Phone</a>
              }
            </td>
            <td>
              @item.Description
              @if (!string.IsNullOrWhiteSpace(item.LastContactNote))
              {
                <div style="margin-top:6px;padding:6px 10px;background:var(--sage);color:var(--sage-ink);border-radius:8px;font-size:0.8rem;">
                  <strong>Contacted @item.LastContactedAt?.ToString("dd MMM, hh:mm tt"):</strong> @item.LastContactNote
                </div>
              }
            </td>
            <td style="white-space:nowrap;">@item.DueDate.ToString("dd MMM yyyy")</td>
            <td>
              <form asp-action="MarkContacted" method="post" class="inline-give">
                @Html.AntiForgeryToken()
                <input type="hidden" name="targetKey" value="@item.TargetKey" />
                <input type="hidden" name="tab" value="@Model.Tab" />
                <input type="text" name="note" placeholder="Contact note..." style="width:160px;" />
                <button type="submit" class="btn teal small" style="margin-left:0;">Mark Contacted</button>
              </form>
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
