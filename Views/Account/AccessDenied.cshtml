@* AccessDenied.cshtml - friendly access-restricted page when a user visits a role-protected route. *@
@{
    ViewData["Title"] = "Access Denied";
}

<div class="card empty-state" style="max-width:560px;margin:48px auto;padding:40px 28px;">
  <svg width="84" height="84" viewBox="0 0 84 84" fill="none" aria-hidden="true">
    <circle cx="42" cy="42" r="40" fill="#F9D0C6"/>
    <rect x="28" y="38" width="28" height="22" rx="6" fill="#1F5F5B"/>
    <path d="M34 38v-6a8 8 0 0 1 16 0v6" stroke="#1F5F5B" stroke-width="4" stroke-linecap="round"/>
    <circle cx="42" cy="49" r="3" fill="#FBE8A6"/>
  </svg>
  <h2 style="margin-top:16px;">Access Denied</h2>
  <p class="muted" style="margin:8px 0 24px;">
    You don't have permission to view this page with your current role. If you think this is a mistake, please ask your clinic administrator.
  </p>
  <div style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;">
    <a class="btn teal" asp-controller="Home" asp-action="Index">Back to Dashboard</a>
    <a class="btn ghost" asp-controller="Public" asp-action="Index">Public Website</a>
  </div>
</div>
