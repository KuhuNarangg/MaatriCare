@* Vaccines.cshtml - clinic-wide vaccination tracker across all newborns with filters and batch recording. *@
@model VaccineTrackerViewModel
@{
    ViewData["Title"] = "Vaccination Tracker";
}

<div class="dash-header">
  <div>
    <h2>Vaccination Tracker</h2>
    <p>Monitor India UIP immunisations across all registered newborns.</p>
  </div>
</div>

@if (TempData["Success"] != null)
{
  <div class="card" style="background:var(--sage);color:var(--sage-ink);border-color:transparent;padding:12px 18px;">
    @TempData["Success"]
  </div>
}

<div class="kpi-grid">
  <div class="kpi-card"><span class="kpi-label">Pending (Upcoming)</span><span class="kpi-val">@Model.TotalPending</span></div>
  <div class="kpi-card"><span class="kpi-label">Due This Week</span><span class="kpi-val">@Model.TotalDueThisWeek</span></div>
  <div class="kpi-card"><span class="kpi-label">Overdue</span><span class="kpi-val accent">@Model.TotalOverdue</span></div>
  <div class="kpi-card"><span class="kpi-label">Given</span><span class="kpi-val">@Model.TotalGiven</span></div>
</div>

<div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
  <a class="page-btn @(Model.Filter == "pending" ? "active" : "")" asp-action="Vaccines" asp-route-filter="pending">Pending &amp; Overdue</a>
  <a class="page-btn @(Model.Filter == "week" ? "active" : "")" asp-action="Vaccines" asp-route-filter="week">Due This Week (@Model.TotalDueThisWeek)</a>
  <a class="page-btn @(Model.Filter == "overdue" ? "active" : "")" asp-action="Vaccines" asp-route-filter="overdue">Overdue (@Model.TotalOverdue)</a>
  <a class="page-btn @(Model.Filter == "given" ? "active" : "")" asp-action="Vaccines" asp-route-filter="given">Given (@Model.TotalGiven)</a>
  <a class="page-btn @(Model.Filter == "all" ? "active" : "")" asp-action="Vaccines" asp-route-filter="all">All</a>
</div>

<div class="card">
  @if (!Model.Items.Any())
  {
    <div class="empty-state">
      <svg width="56" height="56" viewBox="0 0 56 56" fill="none"><circle cx="28" cy="28" r="26" fill="#CFE3D4"/><path d="M18 28l7 7 13-13" stroke="#1F5F5B" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <h3>No vaccines in this filter</h3>
      <p>Switch tabs above to inspect other vaccination statuses.</p>
    </div>
  }
  else
  {
    <table>
      <thead>
        <tr>
          <th>Baby</th>
          <th>Village</th>
          <th>Vaccine</th>
          <th>Due Date</th>
          <th>Status</th>
          <th>Record / Details</th>
        </tr>
      </thead>
      <tbody>
        @foreach (var v in Model.Items)
        {
          <tr>
            <td><a asp-action="Details" asp-route-id="@v.NewbornId"><strong>@v.Newborn?.Name</strong></a></td>
            <td>@v.Newborn?.Mother?.Village</td>
            <td>@v.Name</td>
            <td>@v.DueDate.ToString("dd MMM yyyy")</td>
            <td><span class="pill @(v.Status == "Given" ? "low" : v.Status == "Overdue" ? "high" : "medium")" style="animation:none;">@v.Status</span></td>
            <td>
              @if (v.Status != "Given")
              {
                <form asp-action="Give" asp-route-id="@v.Id" method="post" class="inline-give">
                  @Html.AntiForgeryToken()
                  <input type="hidden" name="returnTo" value="tracker" />
                  <input type="hidden" name="filter" value="@Model.Filter" />
                  <input type="date" name="givenDate" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                  <input type="text" name="batchNumber" placeholder="Batch #" />
                  <button type="submit" class="btn small" style="margin-left:0;">Mark Given</button>
                </form>
              }
              else
              {
                <span class="small muted">Given @v.GivenDate?.ToString("dd MMM yyyy") @(string.IsNullOrWhiteSpace(v.BatchNumber) ? "" : $"• Batch {v.BatchNumber}")</span>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
  }
</div>
