@* Create.cshtml - register a newborn baby with APGAR, gestational age, delivery link, and auto UIP vaccine schedule. *@
@model NewbornFormViewModel
@{
    ViewData["Title"] = "Register Newborn";
    var deliveries = ViewBag.Deliveries as List<Delivery> ?? new();
}

<div class="dash-header">
  <div>
    <h2>Register Newborn</h2>
    <p>Mother: <strong>@Model.MotherName</strong> &bull; 7 India UIP vaccines will be scheduled automatically.</p>
  </div>
  <a class="btn ghost" asp-controller="Mothers" asp-action="Details" asp-route-id="@Model.MotherId">&larr; Back to Mother</a>
</div>

<form method="post" class="card form" style="max-width:580px;" novalidate>
  @Html.AntiForgeryToken()
  <input type="hidden" asp-for="MotherId" />
  <input type="hidden" asp-for="MotherName" />
  <div asp-validation-summary="All" class="err"></div>

  <label asp-for="Name">Baby Name</label>
  <input asp-for="Name" />

  <div class="grid-2">
    <div>
      <label asp-for="Dob">Date of Birth</label>
      <input asp-for="Dob" type="date" />
    </div>
    <div>
      <label asp-for="Gender">Gender</label>
      <select asp-for="Gender">
        <option value="Female">Female</option>
        <option value="Male">Male</option>
      </select>
    </div>
  </div>

  <div class="grid-2">
    <div>
      <label asp-for="BirthWeight">Birth Weight (kg)</label>
      <input asp-for="BirthWeight" type="number" step="0.1" />
    </div>
    <div>
      <label asp-for="ApgarScore">APGAR Score (0–10)</label>
      <input asp-for="ApgarScore" type="number" min="0" max="10" />
    </div>
  </div>

  <label asp-for="GestationalAgeWeeks">Gestational Age at Birth (weeks)</label>
  <input asp-for="GestationalAgeWeeks" type="number" min="24" max="43" placeholder="Under 37 weeks flags Preterm" />

  @if (deliveries.Any())
  {
    <label asp-for="DeliveryId">Link to Delivery Record (optional)</label>
    <select asp-for="DeliveryId">
      <option value="">-- Not linked --</option>
      @foreach (var d in deliveries)
      {
        <option value="@d.Id">@d.DeliveryDate.ToString("dd MMM yyyy") — @d.DeliveryType at @d.Place</option>
      }
    </select>
  }

  <div style="margin-top:20px;">
    <button type="submit" class="btn">Save &amp; Create Vaccine Schedule</button>
  </div>
</form>
