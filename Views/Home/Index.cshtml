@{ int total = ViewBag.Total == 0 ? 1 : ViewBag.Total; }
<h2>Dashboard</h2>
<div class="grid">
  <div class="card stat"><b>@ViewBag.Total</b>Mothers registered</div>
  <div class="card stat"><b>@ViewBag.High</b>High risk</div>
  <div class="card stat"><b>@ViewBag.Newborns</b>Newborns</div>
  <div class="card stat"><b>@ViewBag.OverdueVaccines</b>Overdue vaccines</div>
</div>
<div class="card">
  <h3>Risk distribution</h3>
  <div class="bar"><span class="low" style="width:@(ViewBag.Low * 100 / total)%">Low @ViewBag.Low</span></div>
  <div class="bar"><span class="med" style="width:@(ViewBag.Medium * 100 / total)%">Medium @ViewBag.Medium</span></div>
  <div class="bar"><span class="high" style="width:@(ViewBag.High * 100 / total)%">High @ViewBag.High</span></div>
</div>
<div class="card">
  <h3>Deliveries expected in the next 30 days</h3>
  @if (((List<Mother>)ViewBag.DueSoon).Count == 0) { <p class="muted">No deliveries due soon.</p> }
  @foreach (var m in (List<Mother>)ViewBag.DueSoon) { <p><a asp-controller="Mothers" asp-action="Details" asp-route-id="@m.Id">@m.Name</a> &mdash; EDD @m.Edd.ToString("dd MMM yyyy")</p> }
</div>
