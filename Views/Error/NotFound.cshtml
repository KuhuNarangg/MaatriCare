@* NotFound.cshtml - friendly 404 page with inline SVG illustration and clear navigation back. *@
@{
    Layout = User.Identity?.IsAuthenticated == true ? "_Layout" : "_PublicLayout";
    ViewData["Title"] = "Page Not Found";
}

<div class="container" style="padding:64px 20px;">
  <div class="card empty-state" style="max-width:560px;margin:0 auto;padding:42px 28px;text-align:center;background:#fff;border:1px solid #E7DDD0;border-radius:20px;">
    <svg width="88" height="88" viewBox="0 0 88 88" fill="none" style="margin:0 auto 14px;" aria-hidden="true">
      <circle cx="44" cy="44" r="42" fill="#FBE8A6"/>
      <circle cx="40" cy="40" r="14" stroke="#1F5F5B" stroke-width="4"/>
      <path d="M51 51l12 12" stroke="#F2785C" stroke-width="4.5" stroke-linecap="round"/>
    </svg>
    <h2 style="margin-bottom:8px;">404 &mdash; Page Not Found</h2>
    <p style="color:#617371;margin:0 0 24px;">
      We couldn't find the page you were looking for. It may have been moved or the link may have a typo.
    </p>
    <div style="display:flex;justify-content:center;gap:12px;flex-wrap:wrap;">
      @if (User.Identity?.IsAuthenticated == true)
      {
        <a class="btn teal" asp-controller="Home" asp-action="Index">Go to Dashboard</a>
      }
      <a class="btn btn-primary" asp-controller="Public" asp-action="Index">Go to Home Page</a>
    </div>
  </div>
</div>
